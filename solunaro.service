[Unit]
Description=Solunaro — six-agent AI desk (PAPER ONLY)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solunaro
WorkingDirectory=/opt/solunaro
EnvironmentFile=/opt/solunaro/.env
ExecStart=/usr/bin/python3 /opt/solunaro/run.py loop
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/solunaro

[Install]
WantedBy=multi-user.target
