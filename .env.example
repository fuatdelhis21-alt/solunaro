# Sadece LLM anahtarı. Borsa/cüzdan anahtarı bu projede YOK ve eklenmemeli.
ANTHROPIC_API_KEY=sk-ant-...
# İsteğe bağlı: Telegram bildirimleri (BotFather'dan token, chat id için @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# İsteğe bağlı: CryptoPanic haberleri (config.yaml'da cryptopanic.enabled: true)
CRYPTOPANIC_TOKEN=
